{
  "name": "nina-fit",
  "compatibility_date": "2026-11-01",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nina-fit",
      "database_id": "REPLACE_WITH_THE_ID_FROM_WRANGLER_D1_CREATE"
    }
  ]
}
